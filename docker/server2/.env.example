# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=rubigram_worker
POSTGRES_USER=rubigram
POSTGRES_PASSWORD=change-this-strong-password

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-long-random-secret-key-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=worker.example.com

DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=rubigram_worker
DATABASE_USER=rubigram
DATABASE_PASSWORD=change-this-strong-password
DATABASE_HOST=postgres
DATABASE_PORT=5432

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-this-redis-password
CELERY_BROKER_URL=redis://:change-this-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-this-redis-password@redis:6379/1
CELERY_WORKER_CONCURRENCY=4

# ── Panel contract ────────────────────────────────────────────────────────────
# Must equal MEMBERSHIP_WORKER_SHARED_SECRET on the panel server.
WORKER_SHARED_SECRET=same-secret-as-the-panel
WORKER_PROVIDER=rubigram-worker
WORKER_SIGNATURE_HEADER_PREFIX=X-Balegram

# ── Rubika behaviour ──────────────────────────────────────────────────────────
WORKER_ACTION_DELAY_SECONDS=2
WORKER_ACTION_TIMEOUT_SECONDS=20
WORKER_LOGIN_TIMEOUT_SECONDS=60
WORKER_BONUS_PERCENTAGE=3
WORKER_CALLBACK_TIMEOUT_SECONDS=10
# WORKER_PROXY=socks5://user:pass@host:1080
AUTO_LEAVE_SCAN_INTERVAL_SECONDS=60
