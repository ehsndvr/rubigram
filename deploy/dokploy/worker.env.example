# Paste into the Dokploy Compose service → Environment tab (it becomes the .env
# file next to docker/server2/dokploy-compose.yml at deploy time).

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-long-random-secret-key-at-least-50-chars
DEBUG=False
# the worker's public host name(s); add the host IP when nginx proxies by IP
ALLOWED_HOSTS=worker.example.com,127.0.0.1

# ── Dokploy-managed PostgreSQL (copy "Internal Host" from the database page) ──
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=rubigram_worker
DATABASE_USER=rubigram
DATABASE_PASSWORD=change-this-strong-password
DATABASE_HOST=rubigram-postgres-xxxxxx
DATABASE_PORT=5432

# ── Dokploy-managed Redis ─────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:change-this-redis-password@rubigram-redis-xxxxxx:6379/1
CELERY_RESULT_BACKEND=redis://:change-this-redis-password@rubigram-redis-xxxxxx:6379/1
CELERY_WORKER_CONCURRENCY=8

# ── Ports / build ─────────────────────────────────────────────────────────────
WORKER_PORT=8092                      # host port published for a host nginx (prod 8092, test 8093)
# PIP_INDEX_URL=https://pypi.org/simple   # a PyPI mirror if the server cannot reach pypi.org

# ── Panel contract ────────────────────────────────────────────────────────────
WORKER_SHARED_SECRET=same-secret-as-the-panel-MEMBERSHIP_WORKER_SHARED_SECRET
WORKER_PROVIDER=rubigram-worker
WORKER_SIGNATURE_HEADER_PREFIX=X-Balegram
WORKER_CALLBACK_TIMEOUT_SECONDS=10

# ── Rubika behaviour ──────────────────────────────────────────────────────────
WORKER_ACTION_DELAY_SECONDS=2
WORKER_ACTION_TIMEOUT_SECONDS=20
WORKER_LOGIN_TIMEOUT_SECONDS=60
WORKER_BONUS_PERCENTAGE=3
WORKER_JOB_MAX_WAIT_HOURS=6
WORKER_THROTTLE_CONN_ERROR_SECONDS=60
WORKER_THROTTLE_TOO_REQUESTS_SECONDS=3600
WORKER_SYSTEM_VERSION=Windows 10
WORKER_DEVICE_MODEL=Chrome 145
# WORKER_USER_AGENT=
# WORKER_DEVICE_HASH=
# WORKER_PROXY=socks5://user:pass@host:1080
AUTO_LEAVE_SCAN_INTERVAL_SECONDS=60
WORKER_LOG_LEVEL=INFO
