# Copy to membership_worker/.env (values in the process environment win over this file).

SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,worker.example.com

# Local development: SQLite
DATABASE_PATH=./data/membership_worker.sqlite3
# Production: PostgreSQL
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=rubigram_membership
# DATABASE_USER=rubigram
# DATABASE_PASSWORD=change-me
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432

# The same value as MEMBERSHIP_WORKER_SHARED_SECRET on the panel.
WORKER_SHARED_SECRET=change-this-long-random-secret
# Name reported to the panel (MEMBERSHIP_WORKER_PROVIDER on the panel side).
WORKER_PROVIDER=rubigram-worker
# Header prefix the panel verifies on callbacks (the balegram panel expects X-Balegram).
WORKER_SIGNATURE_HEADER_PREFIX=X-Balegram
WORKER_SIGNATURE_MAX_AGE_SECONDS=300
WORKER_CALLBACK_TIMEOUT_SECONDS=10

# Pacing and limits
WORKER_ACTION_DELAY_SECONDS=2        # minimum gap between two actions of the same account
WORKER_ACTION_TIMEOUT_SECONDS=20     # per Rubika request
WORKER_LOGIN_TIMEOUT_SECONDS=60
WORKER_BONUS_PERCENTAGE=3            # extra members on join orders
WORKER_JOB_MAX_WAIT_HOURS=6          # keep filling missing join slots for this long
WORKER_THROTTLE_CONN_ERROR_SECONDS=60
WORKER_THROTTLE_TOO_REQUESTS_SECONDS=3600

# Rubika client identity (defaults mimic the web client)
# WORKER_USER_AGENT=Mozilla/5.0 ...
# WORKER_DEVICE_HASH=
WORKER_SYSTEM_VERSION=Windows 10
WORKER_DEVICE_MODEL=Chrome 145
# The default exit for every Rubika call. A panel that names a `proxy` on a
# login payload overrides it for that login only.
# WORKER_PROXY=socks5://127.0.0.1:1080

# Where "which address did Rubika actually see?" is asked, and how long to wait
# for the answer. Only asked when a proxy is in play; empty turns it off, which
# is right for a deployment with no outbound to the echo service — the answer is
# evidence, never a precondition for a login.
# WORKER_EGRESS_ECHO_URL=https://api.ipify.org
# WORKER_EGRESS_TIMEOUT_SECONDS=8

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# CELERY_WORKER_CONCURRENCY=8
AUTO_LEAVE_SCAN_INTERVAL_SECONDS=60
# The read-only account health sweep: how often it runs, and how many accounts
# each pass connects to. Every probe is one live connection held for its timeout.
HEALTH_SCAN_INTERVAL_SECONDS=900
HEALTH_SCAN_BATCH=100
WORKER_LOG_LEVEL=INFO
